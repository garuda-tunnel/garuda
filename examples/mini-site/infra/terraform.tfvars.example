# Terraform/OpenTofu variable values for examples/mini-site/infra.
# Copy this file to terraform.tfvars and fill in your real values.
#
# Domains:   replace example.net with your real DNS zone.
# IPs:       replace RFC 5737 addresses with your real public IPs / CIDRs.
# Cloud IDs: replace placeholder IDs with your real cloud resource IDs.
# Secrets:   routeros_password, gcp_credentials_json, cloudflare_api_token are
#            sensitive — keep them out of VCS. The Proxmox API token is not a
#            variable: export PROXMOX_VE_API_TOKEN before running tofu.

env_slug = "mini-site"

proxmox = {
  endpoint      = "https://pve.example.net:8006/"
  node_name     = "my-pve-node"
  pool_id       = "my-pve-pool"
  datastore_id  = "my-datastore"
  bridge        = "vmbr1"
  image_file_id = "local:import/ubuntu-26.04-server-cloudimg-amd64.qcow2"
  gateway       = "203.0.113.1"
  dns_servers   = ["192.0.2.53", "198.51.100.53"]
  hub = {
    address   = "203.0.113.184"
    cores     = 2
    memory_mb = 4096
    disk_gb   = 40
  }
  client = {
    address   = "203.0.113.185"
    cores     = 1
    memory_mb = 2048
    disk_gb   = 20
  }
}

# Stand SSH key: the public key is seeded on every VM, the private key is
# referenced by path only (never read by this root). Write both under umask
# 077 outside VCS, e.g. from your secrets store. known_hosts_file must be
# absolute: the keyscan step and ANSIBLE_SSH_ARGS use it outside this module.
ssh_public_key_file  = "/home/operator/.garuda-stand/id_ed25519.pub"
ssh_private_key_file = "/home/operator/.garuda-stand/id_ed25519"
known_hosts_file     = "/home/operator/.garuda-stand/known_hosts"

k3s_version       = "v1.33.0+k3s1"
cluster_cidrs     = ["10.42.0.0/16", "10.43.0.0/16"]
api_trusted_cidrs = ["192.0.2.0/24", "198.51.100.0/24"]

# GCP edges boot Ubuntu 26.04 LTS (k3s-bootstrap preflight asserts 26.04).
# gcp_image = "projects/ubuntu-os-cloud/global/images/family/ubuntu-2604-lts-amd64"

gcp = {
  project_id = "my-gcp-project"
}

gcp_credentials_json = <<EOT
{ "type": "service_account", "project_id": "my-gcp-project" }
EOT

cloudflare = {
  zone_name = "example.net"
}

cloudflare_api_token = "my-cloudflare-api-token"

# RouterOS bootstrap is count-gated; set routeros_enabled = false for stands
# without RouterOS (the routeros inputs may then be null).
routeros_enabled = true

routeros = {
  hostname         = "routeros-example"
  management_host  = "203.0.113.1"
  user             = "admin"
  uplink_interface = "ether1"
}

routeros_password = "my-routeros-password"

hub_fqdn_prefix = "hub"
base_domain     = "example.net"

edges = {
  pt = {
    machine_type        = "e2-small"
    boot_disk_gb        = 20
    region              = "us-central1"
    zone                = "us-central1-a"
    fqdn_prefix         = "pt"
    hub_cidr            = "192.0.2.129/28"
    peer_cidr           = "192.0.2.130/28"
    listen_port         = 51820
    ospf_router_id_hub  = "198.51.100.20"
    ospf_router_id_peer = "198.51.100.23"
  }
  de = {
    machine_type        = "e2-small"
    boot_disk_gb        = 20
    region              = "europe-west3"
    zone                = "europe-west3-a"
    fqdn_prefix         = "de"
    hub_cidr            = "192.0.2.145/28"
    peer_cidr           = "192.0.2.146/28"
    listen_port         = 51821
    ospf_router_id_hub  = "198.51.100.30"
    ospf_router_id_peer = "198.51.100.33"
  }
}

operator_ssh_keys = [
  "operator:ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIexample operator@example",
]
